> 
>     # Stage 2: x_m → x_1
>     stage2_fn = tm2t_sampler.sample_ode(
>         num_steps=steps_stage2,
>         t0_override=t_min,
>     )
>     x_1 = stage2_fn(x_m, model_fn_tm2t, **model_kwargs)[-1]
> 
>     return x_1
